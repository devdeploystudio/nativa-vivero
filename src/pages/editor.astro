---
import Layout from "../layouts/Layout.astro";
import { withBase } from "../config/site";

// Cada link lleva directo a esa colección puntual dentro del panel real
// (Sveltia CMS, en /admin/). Si no estás logueada todavía, Sveltia pide el
// login primero y después te lleva ahí solo. Esta página es solo un menú
// más claro para llegar, no maneja nada de eso — no va en el menú de
// navegación del sitio, se guarda en favoritos.
// Primero la home, en el mismo orden en que sus bloques aparecen
// scrolleando. Después las páginas aparte (Catálogo, Contacto), y General
// al final — mismo criterio que el resto de los sitios de Deploy.
const grupos = [
  {
    emoji: "🏠",
    nombre: "Inicio",
    items: [
      { label: "Portada: texto", coleccion: "config-inicio-portada-texto" },
      { label: "Portada: fotos", coleccion: "config-inicio-portada-fotos" },
    ],
  },
  {
    emoji: "🪴",
    nombre: "Plantas destacadas",
    items: [{ label: "Ver, agregar y editar plantas destacadas", coleccion: "plantas-destacadas" }],
  },
  {
    emoji: "🔎",
    nombre: "Encontrá tu planta",
    items: [{ label: "Textos del buscador", coleccion: "config-buscador" }],
  },
  {
    emoji: "📸",
    nombre: "Galería",
    items: [{ label: "Fotos y títulos de la galería", coleccion: "config-galeria" }],
  },
  {
    emoji: "🌤️",
    nombre: "Guía de cuidados",
    items: [{ label: "Preguntas y respuestas", coleccion: "config-guia-cuidados" }],
  },
  {
    emoji: "💬",
    nombre: "Testimonios",
    items: [{ label: "Agregar, borrar y reordenar testimonios", coleccion: "testimonios" }],
  },
  {
    emoji: "🔢",
    nombre: "Números",
    items: [{ label: "Las 4 cifras destacadas", coleccion: "config-numeros" }],
  },
  {
    emoji: "🔁",
    nombre: "Cómo funciona",
    items: [{ label: "Los pasos del proceso", coleccion: "config-como-funciona" }],
  },
  {
    emoji: "🌿",
    nombre: "Bloque final",
    items: [{ label: "Título, texto y foto de fondo", coleccion: "config-cta-final" }],
  },
  {
    emoji: "🌱",
    nombre: "Catálogo (página aparte)",
    items: [
      { label: "Portada: título y foto de fondo", coleccion: "config-catalogo-pagina" },
      { label: "Plantas: texto e introducción", coleccion: "config-catalogo-plantas" },
      { label: "Plantas: ver, agregar y editar", coleccion: "plantas-catalogo" },
      { label: "Macetas: texto y paleta de colores", coleccion: "config-catalogo-macetas" },
      { label: "Macetas: ver, agregar y editar", coleccion: "macetas" },
    ],
  },
  {
    emoji: "📍",
    nombre: "Contacto (página aparte)",
    items: [
      { label: "Texto de la página", coleccion: "config-contacto" },
      { label: "Dirección, horario y mapa", coleccion: "config-ubicacion" },
    ],
  },
  {
    emoji: "⚙️",
    nombre: "General",
    items: [{ label: "Eslogan, WhatsApp e Instagram", coleccion: "config" }],
  },
];
---

<Layout title="Editor" description="Menú para editar el contenido del sitio." noindex>
  <section class="mx-auto max-w-[90rem] px-5 py-16 sm:px-8">
    {/* Portón de mail: NO es seguridad real (sitio 100% estático, sin
       backend que valide nada — cualquiera que abra el código fuente ve
       esta misma lista). Es solo para que un visitante casual que llega a
       /editor de curioso no vea directo el menú. La seguridad de verdad
       sigue siendo el login de GitHub de Sveltia en /admin/. */}
    <div id="editor-gate" class="mx-auto max-w-sm py-20 text-center">
      <p class="font-body text-sm font-semibold uppercase tracking-wide text-clay-active">Editor</p>
      <h1 class="mt-2 font-display text-2xl text-ink">Ingresá tu mail</h1>
      <p class="mt-3 font-body text-sm text-muted">Esta sección es solo para el equipo de Nativa Vivero.</p>
      <form id="editor-gate-form" class="mt-6 flex flex-col gap-3">
        <input
          type="email"
          id="editor-gate-email"
          required
          autocomplete="email"
          placeholder="tu@mail.com"
          class="rounded-xl border border-hairline bg-surface px-4 py-3 text-center font-body text-sm text-ink outline-none focus:border-clay-active"
        />
        <button type="submit" class="btn-press rounded-full bg-clay px-6 py-3 font-body text-sm font-semibold text-ink transition-colors hover:bg-clay-active">
          Continuar
        </button>
        <p id="editor-gate-error" class="hidden font-body text-sm text-red-600">Ese mail no tiene acceso a esta sección.</p>
      </form>
    </div>

    <div id="editor-content" class="hidden">
      <p class="font-body text-sm font-semibold uppercase tracking-wide text-clay-active">Editor</p>
      <h1 class="mt-2 font-display text-3xl text-ink sm:text-4xl">¿Qué querés editar?</h1>
      <p class="mt-4 font-body text-base text-muted">
        Elegí abajo qué parte del sitio querés cambiar. La primera vez te va a pedir iniciar sesión con una cuenta de GitHub, algo así como el
        usuario con el que entrás a cualquier servicio: es gratis y se crea en un minuto usando tu mismo Gmail. Una vez que la tengas, siempre vas
        a entrar con esa misma cuenta. Es lo que protege el sitio, para que solo vos puedas cambiar el contenido.
      </p>

      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          grupos.map((grupo) => (
            <article class="rounded-2xl border border-hairline bg-surface p-6">
              <p class="font-display text-lg text-ink">
                <span aria-hidden="true">{grupo.emoji}</span> {grupo.nombre}
              </p>
              <div class="mt-4 flex flex-col gap-2.5">
                {grupo.items.map((item) => (
                  <a
                    href={withBase(`/admin/index.html#/collections/${item.coleccion}`)}
                    class="rounded-xl border border-hairline px-4 py-3 font-body text-sm font-semibold text-ink transition-colors hover:border-clay-active hover:text-clay-active"
                  >
                    {item.label} →
                  </a>
                ))}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

<script>
  // Lista de mails permitidos. Solo obscurece el acceso casual — ver el
  // comentario grande más arriba.
  const MAILS_PERMITIDOS = ["marumungo@gmail.com", "contact.deploystudio@gmail.com"];
  const STORAGE_KEY = "editor-mail-ok";

  const gate = document.getElementById("editor-gate")!;
  const content = document.getElementById("editor-content")!;
  const form = document.getElementById("editor-gate-form") as HTMLFormElement;
  const input = document.getElementById("editor-gate-email") as HTMLInputElement;
  const error = document.getElementById("editor-gate-error")!;

  function desbloquear() {
    gate.classList.add("hidden");
    content.classList.remove("hidden");
  }

  const mailGuardado = localStorage.getItem(STORAGE_KEY);
  if (mailGuardado && MAILS_PERMITIDOS.includes(mailGuardado)) desbloquear();

  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    const mail = input.value.trim().toLowerCase();
    if (MAILS_PERMITIDOS.includes(mail)) {
      localStorage.setItem(STORAGE_KEY, mail);
      error.classList.add("hidden");
      desbloquear();
    } else {
      error.classList.remove("hidden");
    }
  });
</script>
