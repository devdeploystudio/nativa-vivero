---
import { getEntry } from "astro:content";

const g = (await getEntry("configGuiaCuidados", "guiaCuidados"))!.data;

// Ícono significativo por tema (no decorativo): el panel elige entre este
// set fijo por "select", nunca texto libre, para que el dibujo siempre
// quede prolijo. Ver criterio de íconos en el doc de panel de Deploy.
const ICONOS: Record<string, string> = {
  luz: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" stroke-linecap="round"/>',
  riego: '<path d="M12 3s6 6.5 6 11a6 6 0 0 1-12 0c0-4.5 6-11 6-11Z" stroke-linejoin="round"/>',
  trasplante: '<path d="M12 21v-8M12 13c-3.5 0-6-2.2-6-6 4 0 6 1.8 6 4M12 13c3.5 0 6-2.2 6-6-4 0-6 1.8-6 4" stroke-linecap="round" stroke-linejoin="round"/><path d="M6 21h12" stroke-linecap="round"/>',
  hojas: '<path d="M6 20c-1-5 1-13 12-15-1 9-5 13-12 15Z" stroke-linejoin="round"/><path d="M7.5 18.5 15 8" stroke-linecap="round"/>',
  mascotas: '<circle cx="7" cy="9" r="1.6"/><circle cx="12" cy="6.5" r="1.6"/><circle cx="17" cy="9" r="1.6"/><path d="M12 12.5c3 0 5 2 5 4.2 0 1.8-1.4 2.8-3 2.3l-.6-.2a3 3 0 0 0-2.8 0l-.6.2c-1.6.5-3-.5-3-2.3 0-2.2 2-4.2 5-4.2Z"/>',
};
---

<section id="cuidados" class="mx-auto max-w-[90rem] px-5 py-12 sm:px-8 lg:py-20">
  <div class="max-w-2xl">
    <p class="reveal-on-scroll font-body text-sm font-semibold uppercase tracking-[0.18em] text-clay-active">{g.kicker}</p>
    <h2 class="reveal-on-scroll section-rule mt-3 font-display text-3xl text-ink sm:text-4xl">{g.titulo}</h2>
  </div>

  <div class="mt-10 grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:gap-14">
    <div class="reveal-on-scroll aspect-[4/3] overflow-hidden rounded-3xl bg-surface-soft lg:sticky lg:top-24 lg:aspect-auto lg:self-stretch">
      <img src={g.imagen} alt="" width="800" height="800" loading="lazy" class="h-full w-full object-cover" />
    </div>

    <div class="flex flex-col gap-3">
      {
        g.items.map((item, i) => (
          <div class="accordion-item overflow-hidden rounded-2xl border border-hairline bg-surface reveal-on-scroll">
            <button
              type="button"
              class="accordion-trigger flex w-full items-center gap-4 px-5 py-4 text-left"
              aria-expanded={i === 0 ? "true" : "false"}
            >
              <span
                class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-forest/10 text-forest"
                set:html={`<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">${ICONOS[item.icono] ?? ""}</svg>`}
              />
              <span class="flex-1 font-body text-base font-semibold text-ink">{item.pregunta}</span>
              <svg class="accordion-caret shrink-0 text-clay-active" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
                <path d="M6 9l6 6 6-6" />
              </svg>
            </button>
            <div class="accordion-panel" style={i === 0 ? "grid-template-rows: 1fr;" : undefined}>
              <div class="overflow-hidden">
                <p class="px-5 pb-5 pl-[4.5rem] font-body text-sm leading-relaxed text-muted">{item.respuesta}</p>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .accordion-panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .accordion-caret {
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .accordion-trigger[aria-expanded="true"] .accordion-caret {
    transform: rotate(180deg);
  }
  @media (prefers-reduced-motion: reduce) {
    .accordion-panel,
    .accordion-caret {
      transition: none;
    }
  }
</style>

<script>
  const triggers = document.querySelectorAll<HTMLButtonElement>(".accordion-trigger");
  triggers.forEach((trigger) => {
    trigger.addEventListener("click", () => {
      const panel = trigger.nextElementSibling as HTMLElement;
      const isOpen = trigger.getAttribute("aria-expanded") === "true";
      trigger.setAttribute("aria-expanded", String(!isOpen));
      panel.style.gridTemplateRows = isOpen ? "0fr" : "1fr";
    });
  });
</script>
