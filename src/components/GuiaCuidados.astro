---
import { getEntry } from "astro:content";
import Icon from "./Icon.astro";
import { withBase } from "../config/site";

const g = (await getEntry("configGuiaCuidados", "guiaCuidados"))!.data;
---

<section id="cuidados" class="mx-auto max-w-[90rem] px-5 py-12 sm:px-8 lg:py-20">
  <div class="max-w-2xl">
    <p class="reveal-on-scroll font-body text-sm font-semibold uppercase tracking-[0.18em] text-clay-active">{g.kicker}</p>
    <h2 class="reveal-on-scroll section-rule mt-3 font-display text-3xl text-ink sm:text-4xl">{g.titulo}</h2>
  </div>

  <div class="mt-10 grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:gap-14">
    <div class="reveal-on-scroll aspect-[4/3] overflow-hidden rounded-3xl bg-surface-soft lg:sticky lg:top-24 lg:aspect-auto lg:self-stretch">
      <img src={withBase(g.imagen)} alt="" width="800" height="800" loading="lazy" class="h-full w-full object-cover" />
    </div>

    <div class="flex flex-col gap-3">
      {
        g.items.map((item) => (
          <div class="accordion-item overflow-hidden rounded-2xl border border-hairline bg-surface reveal-on-scroll">
            <button type="button" class="accordion-trigger flex w-full items-center gap-4 px-5 py-4 text-left" aria-expanded="false">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-forest/10 text-forest">
                <Icon icono={item.icono} class="h-5 w-5" />
              </span>
              <span class="flex-1 font-body text-base font-semibold text-ink">{item.pregunta}</span>
              <svg class="accordion-caret shrink-0 text-clay-active" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
                <path d="M6 9l6 6 6-6" />
              </svg>
            </button>
            <div class="accordion-panel">
              <div class="overflow-hidden">
                <p class="px-5 pb-5 pl-[4.5rem] font-body text-sm leading-relaxed text-muted">{item.respuesta}</p>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .accordion-panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .accordion-caret {
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .accordion-trigger[aria-expanded="true"] .accordion-caret {
    transform: rotate(180deg);
  }
  @media (prefers-reduced-motion: reduce) {
    .accordion-panel,
    .accordion-caret {
      transition: none;
    }
  }
</style>

<script>
  const triggers = document.querySelectorAll<HTMLButtonElement>(".accordion-trigger");
  triggers.forEach((trigger) => {
    trigger.addEventListener("click", () => {
      const panel = trigger.nextElementSibling as HTMLElement;
      const isOpen = trigger.getAttribute("aria-expanded") === "true";
      trigger.setAttribute("aria-expanded", String(!isOpen));
      panel.style.gridTemplateRows = isOpen ? "0fr" : "1fr";
    });
  });
</script>
