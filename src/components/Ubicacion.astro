---
import { getEntry } from "astro:content";
import { WHATSAPP_NUMBER } from "../config/site";
import { buildConsultaGeneralLink } from "../lib/whatsapp";

const u = (await getEntry("configUbicacion", "ubicacion"))!.data;
const waLink = buildConsultaGeneralLink(WHATSAPP_NUMBER);

// Iframe de Google Maps sin API key (truco conocido: "q=lat,lng&output=embed"),
// armado solo a partir de las dos coordenadas cargadas en el panel.
const mapaEmbedUrl = `https://www.google.com/maps?q=${u.lat},${u.lng}&z=15&output=embed`;
---

<section id="ubicacion" class="bg-surface-soft py-12 lg:py-20">
  <div class="mx-auto grid max-w-[90rem] gap-10 px-5 sm:px-8 lg:grid-cols-2 lg:items-center">
    <div class="reveal-on-scroll order-2">
      <p class="font-body text-sm font-semibold uppercase tracking-[0.18em] text-clay-active">Ubicación</p>
      <h2 class="section-rule mt-3 font-display text-3xl text-ink sm:text-4xl">{u.titulo}</h2>

      <dl class="mt-8 flex flex-col gap-5">
        <div>
          <dt class="font-body text-xs font-semibold uppercase tracking-wide text-muted">Dirección</dt>
          <dd class="mt-1 font-body text-base text-ink">{u.direccion}</dd>
        </div>
        <div>
          <dt class="font-body text-xs font-semibold uppercase tracking-wide text-muted">Horario</dt>
          <dd class="mt-1 font-body text-base text-ink">{u.horario}</dd>
        </div>
      </dl>

      <a
        href={waLink}
        target="_blank"
        rel="noopener noreferrer"
        data-ubicacion="mapa"
        class="btn-press mt-8 inline-flex rounded-full bg-clay px-6 py-3.5 font-body text-sm font-semibold text-ink transition-colors hover:bg-clay-active"
      >
        Coordinar visita por WhatsApp
      </a>
    </div>

    <div class="reveal-on-scroll order-1 aspect-[4/3] overflow-hidden rounded-3xl border border-hairline lg:aspect-auto lg:h-[26rem]">
      <iframe src={mapaEmbedUrl} title="Ubicación de Nativa Vivero en el mapa" class="h-full w-full grayscale-[35%]" loading="lazy" referrerpolicy="no-referrer-when-downgrade" />
    </div>
  </div>
</section>
