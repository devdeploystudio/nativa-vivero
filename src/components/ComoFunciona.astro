---
import { getEntry } from "astro:content";
import Icon from "./Icon.astro";

const c = (await getEntry("configComoFunciona", "comoFunciona"))!.data;
---

<section class="mx-auto max-w-[90rem] px-5 py-12 sm:px-8 lg:py-20">
  <div class="mx-auto max-w-2xl text-center">
    <p class="reveal-on-scroll font-body text-sm font-semibold uppercase tracking-[0.18em] text-clay-active">Proceso</p>
    <h2 class="reveal-on-scroll section-rule mx-auto mt-3 font-display text-3xl text-ink sm:text-4xl">{c.titulo}</h2>
    <p class="reveal-on-scroll mt-4 font-body text-base text-muted">{c.texto}</p>
  </div>

  <ol class="relative mt-16 grid gap-10 sm:grid-cols-2 lg:grid-cols-4 lg:gap-6">
    <div class="pasos-linea absolute left-0 right-0 top-7 hidden lg:block" aria-hidden="true"></div>
    {
      c.pasos.map((p) => (
        <li class="reveal-on-scroll relative flex flex-col items-center px-2 text-center">
          <span class="relative z-10 flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-forest text-canvas">
            <Icon icono={p.icono} class="h-6 w-6" />
          </span>
          <h3 class="mt-4 font-display text-lg text-ink">{p.titulo}</h3>
          <p class="mt-1.5 max-w-[16rem] font-body text-sm text-muted">{p.texto}</p>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .pasos-linea {
    height: 2px;
    background: repeating-linear-gradient(to right, var(--color-hairline) 0 8px, transparent 8px 14px);
  }
</style>
