---
import { getEntry, getCollection } from "astro:content";
import { WHATSAPP_NUMBER, withBase } from "../config/site";
import { buildConsultaPlantaLink } from "../lib/whatsapp";

const c = (await getEntry("configCatalogoPlantas", "catalogoPlantas"))!.data;
const plantas = (await getCollection("plantasCatalogo")).sort((a, b) => a.data.orden - b.data.orden);

const LUZ_LABEL: Record<string, string> = { poca: "Poca luz", media: "Luz media", mucha: "Mucha luz" };
const DIFICULTAD_LABEL: Record<string, string> = { facil: "Fácil", intermedia: "Intermedia", experta: "Experta" };

// Taxonomía de filtros: fija en código (no editable desde el panel), a
// propósito — es la estructura de navegación del catálogo, no contenido de
// marketing. Lo que SÍ es editable es qué categorías tiene cada planta
// (campo "categorias" de cada entrada de plantasCatalogo).
const TABS = [
  { valor: "todas", label: "Todas" },
  { valor: "interior", label: "Interior" },
  { valor: "exterior", label: "Exterior" },
  { valor: "colgante", label: "Colgantes" },
  { valor: "con-flor", label: "Con flor" },
  { valor: "pet-friendly", label: "Pet-friendly" },
];
---

<section class="py-12 lg:py-20">
  <div class="mx-auto max-w-[90rem] px-5 sm:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <p class="reveal-on-scroll font-body text-sm font-semibold uppercase tracking-[0.18em] text-clay-active">{c.kicker}</p>
      <h2 class="reveal-on-scroll section-rule mx-auto mt-3 font-display text-3xl text-ink sm:text-4xl">{c.titulo}</h2>
      <p class="reveal-on-scroll mt-4 font-body text-base text-muted">{c.texto}</p>
    </div>

    <div class="mt-10 flex flex-wrap justify-center gap-2" role="tablist" aria-label="Filtrar catálogo">
      {
        TABS.map((tab, i) => (
          <button
            type="button"
            class="catalogo-tab btn-press rounded-full border border-hairline bg-surface px-4 py-2 font-body text-sm font-semibold text-body transition-colors"
            class:list={[{ "is-active": i === 0 }]}
            data-filtro={tab.valor}
            role="tab"
            aria-selected={i === 0 ? "true" : "false"}
          >
            {tab.label}
          </button>
        ))
      }
    </div>

    <div class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4" id="catalogo-grid">
      {
        plantas.map((p) => {
          const d = p.data;
          const waLink = buildConsultaPlantaLink(WHATSAPP_NUMBER, d.nombre);
          return (
            <article class="catalogo-card group overflow-hidden rounded-2xl bg-surface" data-categorias={d.categorias.join(" ")}>
              <div class="aspect-square overflow-hidden">
                <img
                  src={withBase(d.imagen)}
                  alt={d.nombre}
                  width="500"
                  height="500"
                  loading="lazy"
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
              </div>
              <div class="p-4">
                <h3 class="font-display text-lg text-ink">{d.nombre}</h3>
                <p class="mt-1 font-body text-xs text-muted">
                  {LUZ_LABEL[d.luz]} · {DIFICULTAD_LABEL[d.dificultad]}
                </p>
                <a
                  href={waLink}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-ubicacion={`catalogo-${p.id}`}
                  class="mt-3 inline-block font-body text-sm font-semibold text-clay-active hover:underline"
                >
                  Consultar →
                </a>
              </div>
            </article>
          );
        })
      }
    </div>

    <p id="catalogo-empty" class="mt-10 hidden text-center font-body text-sm text-muted">
      No tenemos plantas de esta categoría en la muestra. Preguntanos por WhatsApp, seguro tenemos algo que te sirve.
    </p>
  </div>
</section>

<style>
  .catalogo-tab.is-active {
    background-color: var(--color-ink);
    border-color: var(--color-ink);
    color: var(--color-canvas);
  }
</style>

<script>
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>(".catalogo-tab"));
  const cards = Array.from(document.querySelectorAll<HTMLElement>(".catalogo-card"));
  const empty = document.getElementById("catalogo-empty")!;

  function applyFilter(valor: string) {
    let visibles = 0;
    for (const card of cards) {
      const categorias = card.dataset.categorias?.split(" ") ?? [];
      const show = valor === "todas" || categorias.includes(valor);
      card.classList.toggle("hidden", !show);
      if (show) visibles++;
    }
    empty.classList.toggle("hidden", visibles > 0);
  }

  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      tabs.forEach((t) => {
        t.classList.remove("is-active");
        t.setAttribute("aria-selected", "false");
      });
      tab.classList.add("is-active");
      tab.setAttribute("aria-selected", "true");
      applyFilter(tab.dataset.filtro ?? "todas");
    });
  });
</script>
