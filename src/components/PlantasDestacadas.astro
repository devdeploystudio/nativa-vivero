---
import { getCollection } from "astro:content";
import { WHATSAPP_NUMBER } from "../config/site";
import { buildConsultaPlantaLink } from "../lib/whatsapp";

const plantas = (await getCollection("plantasDestacadas")).sort((a, b) => a.data.orden - b.data.orden);

const LUZ_LABEL: Record<string, string> = { poca: "Poca luz", media: "Luz media", mucha: "Mucha luz" };
const RIEGO_LABEL: Record<string, string> = { bajo: "Riego bajo", moderado: "Riego moderado", frecuente: "Riego frecuente" };
const DIFICULTAD_LABEL: Record<string, string> = { facil: "Fácil", intermedia: "Intermedia", experta: "Experta" };
---

<section id="destacadas" class="py-12 lg:py-20">
  <div class="mx-auto flex max-w-[90rem] flex-wrap items-end justify-between gap-6 px-5 sm:px-8">
    <div class="max-w-xl">
      <p class="reveal-on-scroll font-body text-sm font-semibold uppercase tracking-[0.18em] text-clay-active">Plantas destacadas</p>
      <h2 class="reveal-on-scroll section-rule mt-3 font-display text-3xl text-ink sm:text-4xl">Nuestras plantas favoritas, una por una</h2>
    </div>
    <div class="reveal-on-scroll hidden gap-2 sm:flex">
      <button id="destacadas-prev" type="button" aria-label="Planta anterior" class="btn-press flex h-11 w-11 items-center justify-center rounded-full border border-hairline text-ink hover:bg-surface-soft">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6" /></svg>
      </button>
      <button id="destacadas-next" type="button" aria-label="Planta siguiente" class="btn-press flex h-11 w-11 items-center justify-center rounded-full border border-hairline text-ink hover:bg-surface-soft">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6" /></svg>
      </button>
    </div>
  </div>

  <div class="mx-auto max-w-[90rem]">
  <div id="destacadas-track" class="mt-10 flex snap-x snap-mandatory gap-5 overflow-x-auto px-5 pb-4 sm:px-8 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
    {
      plantas.map((p, i) => {
        const d = p.data;
        const waLink = buildConsultaPlantaLink(WHATSAPP_NUMBER, d.nombre);
        return (
          <article class="reveal-on-scroll w-[82vw] shrink-0 snap-start overflow-hidden rounded-3xl border border-hairline bg-surface sm:w-[26rem]">
            <div class="aspect-[4/3] overflow-hidden bg-surface-soft">
              <img src={d.imagen} alt={d.nombre} width="800" height="600" loading={i === 0 ? "eager" : "lazy"} class="h-full w-full object-cover" />
            </div>
            <div class="p-6">
              <p class="font-display text-sm italic text-muted">{d.nombreCientifico}</p>
              <h3 class="mt-1 font-display text-2xl text-ink">{d.nombre}</h3>
              <p class="mt-3 font-body text-sm leading-relaxed text-body">{d.descripcion}</p>

              <ul class="mt-5 flex flex-wrap gap-2">
                <li class="rounded-full border border-hairline bg-canvas px-3 py-1 font-body text-xs font-semibold text-ink">{LUZ_LABEL[d.luz]}</li>
                <li class="rounded-full border border-hairline bg-canvas px-3 py-1 font-body text-xs font-semibold text-ink">{RIEGO_LABEL[d.riego]}</li>
                <li class="rounded-full border border-hairline bg-canvas px-3 py-1 font-body text-xs font-semibold text-ink">{DIFICULTAD_LABEL[d.dificultad]}</li>
                {d.petFriendly && <li class="rounded-full border border-hairline bg-canvas px-3 py-1 font-body text-xs font-semibold text-forest">🐾 Pet-friendly</li>}
              </ul>

              <a
                href={waLink}
                target="_blank"
                rel="noopener noreferrer"
                data-ubicacion={`destacada-${p.id}`}
                class="btn-press mt-6 inline-flex items-center gap-2 rounded-full bg-ink px-5 py-2.5 font-body text-sm font-semibold text-canvas transition-colors hover:bg-forest-deep"
              >
                Consultar disponibilidad
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg>
              </a>
            </div>
          </article>
        );
      })
    }
  </div>
  </div>
</section>

<script>
  const track = document.getElementById("destacadas-track");
  const prev = document.getElementById("destacadas-prev");
  const next = document.getElementById("destacadas-next");
  if (track && prev && next) {
    const scrollByCard = (dir: number) => {
      const card = track.querySelector("article");
      const amount = (card?.clientWidth ?? 320) + 20;
      track.scrollBy({ left: dir * amount, behavior: "smooth" });
    };
    prev.addEventListener("click", () => scrollByCard(-1));
    next.addEventListener("click", () => scrollByCard(1));
  }
</script>
