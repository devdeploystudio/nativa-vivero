---
import { getCollection } from "astro:content";

const testimonios = (await getCollection("testimonios")).sort((a, b) => a.data.orden - b.data.orden);
---

<section class="mx-auto max-w-3xl px-5 py-12 sm:px-8 lg:py-20">
  <div class="text-center">
    <p class="reveal-on-scroll font-body text-sm font-semibold uppercase tracking-[0.18em] text-clay-active">Testimonios</p>
    <h2 class="reveal-on-scroll section-rule mx-auto mt-3 font-display text-3xl text-ink sm:text-4xl">Lo que dicen quienes ya vinieron</h2>
  </div>

  <div class="reveal-on-scroll relative mt-10 overflow-hidden">
    <div id="testimonios-track" class="flex transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)]">
      {
        testimonios.map((t) => (
          <figure class="w-full shrink-0 px-2 text-center">
            <svg viewBox="0 0 24 24" width="28" height="28" class="mx-auto text-clay" fill="currentColor">
              <path d="M9.5 6C6.5 7.5 5 10 5 13c0 2.5 1.5 4 3.5 4S12 15.5 12 13.5c0-1.5-1-2.5-2.5-3 0-1.5 1-3 3-4L9.5 6zm9 0C15.5 7.5 14 10 14 13c0 2.5 1.5 4 3.5 4s3.5-1.5 3.5-3.5c0-1.5-1-2.5-2.5-3 0-1.5 1-3 3-4L18.5 6z" />
            </svg>
            <blockquote class="mt-4 font-display text-xl italic leading-relaxed text-ink sm:text-2xl">“{t.data.texto}”</blockquote>
            <figcaption class="mt-5 font-body text-sm text-muted">
              <span class="font-semibold text-ink">{t.data.nombre}</span> · {t.data.rol}
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>

  <div class="mt-6 flex justify-center gap-2">
    {testimonios.map((_, i) => <button class="testimonios-dot h-2 w-2 rounded-full bg-hairline transition-colors" data-index={i} aria-label={`Ir al testimonio ${i + 1}`} />)}
  </div>
</section>

<style>
  .testimonios-dot.is-active {
    background-color: var(--color-clay-active);
    width: 1.4rem;
    border-radius: 999px;
  }
</style>

<script>
  const track = document.getElementById("testimonios-track");
  const dots = Array.from(document.querySelectorAll<HTMLElement>(".testimonios-dot"));
  const total = dots.length;
  if (track && total > 0) {
    let current = 0;
    let timer: ReturnType<typeof setInterval> | undefined;

    function goTo(i: number) {
      current = (i + total) % total;
      track!.style.transform = `translateX(-${current * 100}%)`;
      dots.forEach((d, idx) => d.classList.toggle("is-active", idx === current));
    }
    function start() {
      stop();
      timer = setInterval(() => goTo(current + 1), 6000);
    }
    function stop() {
      if (timer) clearInterval(timer);
    }

    goTo(0);
    dots.forEach((dot, i) =>
      dot.addEventListener("click", () => {
        goTo(i);
        start();
      }),
    );
    track.closest("section")?.addEventListener("mouseenter", stop);
    track.closest("section")?.addEventListener("mouseleave", start);

    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) start();
  }
</script>
